SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///instance/econ_test.db
FLASK_ENV=production

# Email notifications (optional). Leave SMTP_HOST unset to disable email
# entirely — the app works fine without it, teachers just won't get
# notifications. Example values below are for Gmail (use an "App Password",
# not your normal password: https://myaccount.google.com/apppasswords) —
# any SMTP provider works the same way (Outlook, SendGrid, Mailgun, etc.).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-institute@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM=your-institute@gmail.com
# SMTP_USE_TLS=true

# Web Push notifications (optional). Leave unset to disable — the app works
# fine without it, the "Enable notifications" buttons just don't appear.
# Generate a VAPID key pair once (see README) and paste the values here /
# into your host's environment. VAPID_SUBJECT must be a mailto: URL.
# VAPID_PUBLIC_KEY=BEl... (87-88 chars, base64url)
# VAPID_PRIVATE_KEY=MIGH... (base64url DER)
# VAPID_SUBJECT=mailto:you@institute.com
