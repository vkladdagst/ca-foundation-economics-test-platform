SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///instance/econ_test.db
FLASK_ENV=production

# Email notifications (optional). Leave SMTP_HOST unset to disable email
# entirely — the app works fine without it, teachers just won't get
# notifications. Example values below are for Gmail (use an "App Password",
# not your normal password: https://myaccount.google.com/apppasswords) —
# any SMTP provider works the same way (Outlook, SendGrid, Mailgun, etc.).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-institute@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM=your-institute@gmail.com
# SMTP_USE_TLS=true
