SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///instance/econ_test.db
FLASK_ENV=production

# Email notifications (optional). Leave unset to disable — the app works
# fine without it, teachers just won't get notifications. Sent via Brevo's
# HTTP API (brevo.com, free tier: 300 emails/day) rather than raw SMTP —
# cloud hosts including Render block outbound SMTP on every plan, so an
# SMTP-based setup can never work once deployed, only locally.
#   1. Sign up at brevo.com (free, no card required).
#   2. Settings -> SMTP & API -> API Keys -> generate one -> BREVO_API_KEY.
#   3. Senders, Domains & Dedicated IPs -> add EMAIL_FROM as a sender and
#      confirm it via the verification email Brevo sends you.
# BREVO_API_KEY=xkeysib-...
# EMAIL_FROM=your-institute@gmail.com
# EMAIL_FROM_NAME=CA Foundation Economics Test Platform

# Web Push notifications (optional). Leave unset to disable — the app works
# fine without it, the "Enable notifications" buttons just don't appear.
# Generate a VAPID key pair once (see README) and paste the values here /
# into your host's environment. VAPID_SUBJECT must be a mailto: URL.
# VAPID_PUBLIC_KEY=BEl... (87-88 chars, base64url)
# VAPID_PRIVATE_KEY=MIGH... (base64url DER)
# VAPID_SUBJECT=mailto:you@institute.com
